{
  "font": {
    "family": {
      "sans": {
        "$value": "\"Outfit\", Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "$type": "fontFamily",
        "$description": "Default sans-serif stack. Outfit is the primary face (Decision D8); Inter is the fallback before system fonts. Loading Outfit is the consumer's responsibility — rule 8 of the consumer rules linked from the README."
      },
      "mono": {
        "$value": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
        "$type": "fontFamily",
        "$description": "Default monospace stack for code."
      }
    },
    "weight": {
      "regular": {
        "$value": "400",
        "$type": "fontWeight"
      },
      "medium": {
        "$value": "500",
        "$type": "fontWeight"
      },
      "semibold": {
        "$value": "600",
        "$type": "fontWeight"
      },
      "bold": {
        "$value": "700",
        "$type": "fontWeight"
      }
    },
    "size": {
      "xs": {
        "$value": "0.75rem",
        "$type": "dimension",
        "$description": "12px. Helper text, captions."
      },
      "sm": {
        "$value": "0.875rem",
        "$type": "dimension",
        "$description": "14px. Body default in Pharos (Decision D3: formalizes Alexandria's dominant body size)."
      },
      "base": {
        "$value": "1rem",
        "$type": "dimension",
        "$description": "16px. Reserved for increased-legibility contexts."
      },
      "lg": {
        "$value": "1.125rem",
        "$type": "dimension",
        "$description": "18px."
      },
      "xl": {
        "$value": "1.25rem",
        "$type": "dimension",
        "$description": "20px."
      },
      "2xl": {
        "$value": "1.5rem",
        "$type": "dimension",
        "$description": "24px. Heading level 3 / large titles."
      },
      "3xl": {
        "$value": "1.875rem",
        "$type": "dimension",
        "$description": "30px. Heading level 2."
      },
      "4xl": {
        "$value": "2.25rem",
        "$type": "dimension",
        "$description": "36px. Heading level 1."
      },
      "5xl": {
        "$value": "3rem",
        "$type": "dimension",
        "$description": "48px. Display."
      }
    },
    "lineHeight": {
      "tight": {
        "$value": "1.25",
        "$type": "number"
      },
      "snug": {
        "$value": "1.375",
        "$type": "number"
      },
      "normal": {
        "$value": "1.5",
        "$type": "number",
        "$description": "Default body line-height."
      },
      "relaxed": {
        "$value": "1.625",
        "$type": "number"
      },
      "loose": {
        "$value": "2",
        "$type": "number"
      }
    },
    "letterSpacing": {
      "tight": {
        "$value": "-0.025em",
        "$type": "dimension"
      },
      "normal": {
        "$value": "0",
        "$type": "dimension"
      },
      "wide": {
        "$value": "0.025em",
        "$type": "dimension"
      }
    }
  },
  "type": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.5xl}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "1.1",
        "letterSpacing": "{font.letterSpacing.tight}"
      },
      "$description": "Display (5xl). Brand surfaces and covers."
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.4xl}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.lineHeight.tight}",
        "letterSpacing": "-0.02em"
      },
      "$description": "H1 (4xl)."
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.3xl}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.lineHeight.tight}",
        "letterSpacing": "{font.letterSpacing.normal}"
      },
      "$description": "H2 (3xl)."
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.2xl}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.lineHeight.tight}",
        "letterSpacing": "{font.letterSpacing.normal}"
      },
      "$description": "H3 / large titles (2xl)."
    },
    "h4": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xl}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.lineHeight.tight}",
        "letterSpacing": "{font.letterSpacing.normal}"
      },
      "$description": "H4 (xl)."
    },
    "lesson-title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xl}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.lineHeight.tight}",
        "letterSpacing": "{font.letterSpacing.normal}"
      },
      "$description": "DEPRECATED: use --pharos-type-h4. Removed in the next major.",
      "$deprecated": "Use --pharos-type-h4: Pharos names text styles by their level, not by one product's content. Removed in the next major."
    },
    "subtitle": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.lg}",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": "{font.lineHeight.tight}",
        "letterSpacing": "{font.letterSpacing.normal}"
      },
      "$description": "Subtitles (lg)."
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.sm}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.lineHeight.normal}",
        "letterSpacing": "{font.letterSpacing.normal}"
      },
      "$description": "Body default (sm, 14px / 1.5). Colour signals interaction, not bold."
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xs}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.lineHeight.normal}",
        "letterSpacing": "0.06em"
      },
      "$description": "Tiny eyebrow / caption labels (xs), ALL-CAPS with wide tracking; helper text at 400."
    }
  }
}
